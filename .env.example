# Copy to .env and adjust. Read by docker compose; for a local run (pnpm start) export the needed variables yourself.

# --- Docker Compose ---
# Host port and bind address. The editor and API have NO authentication, so by default localhost only.
# Expose externally (0.0.0.0) only behind a proxy/VPN with authorization.
FL0W_PORT=3000
FL0W_BIND=127.0.0.1
# Image: your own registry, e.g. ghcr.io/you/fl0w:0.1.0 (built locally by default)
# FL0W_IMAGE=fl0w:local

# Storage. A Docker volume name (default) OR a host path (./data/flows, /srv/fl0w/files).
# The host path must exist and be owned by uid 1000 (chown -R 1000:1000 <directory>).
# FL0W_DATA=fl0w-data      # flows and memory banks  -> /data
# FL0W_FILES=fl0w-files    # directory for Files / Local File Trigger / Shell blocks -> /data/files

# --- Application features (read by the server) ---
# Shell block. ENABLE ONLY on a machine that only you can access (see docs/BLOCKS.md).
# FL0W_ALLOW_SHELL=1
# Public https address of the server (needed for Telegram webhooks), without a path
# FL0W_PUBLIC_URL=https://fl0w.example.com
# Custom Telegram Bot API server
# FL0W_TELEGRAM_API=https://api.telegram.org
# Secrets: block parameters reference them as env:FL0W_SECRET_NAME
# FL0W_SECRET_TELEGRAM_BOT_TOKEN=
