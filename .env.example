# Скопируйте в .env и поправьте. Читается docker compose; для локального запуска (pnpm start) экспортируйте нужные переменные сами.

# --- Docker Compose ---
# Порт на хосте и адрес привязки. Редактор и API БЕЗ аутентификации — по умолчанию только localhost.
# Открывайте наружу (0.0.0.0) только за прокси/VPN с авторизацией.
FL0W_PORT=3000
FL0W_BIND=127.0.0.1
# Образ: свой реестр, например ghcr.io/you/fl0w:0.1.0 (по умолчанию собирается локально)
# FL0W_IMAGE=fl0w:local

# Хранилища. Имя тома Docker (по умолчанию) ИЛИ путь на хосте (./data/flows, /srv/fl0w/files).
# Путь на хосте должен существовать и принадлежать uid 1000 (chown -R 1000:1000 <каталог>).
# FL0W_DATA=fl0w-data      # флоу и банки памяти  -> /data
# FL0W_FILES=fl0w-files    # каталог блоков Files / Local File Trigger / Shell -> /data/files

# --- Функции приложения (читаются сервером) ---
# Блок Shell. ВКЛЮЧАЙТЕ ТОЛЬКО на машине, куда имеете доступ лишь вы (см. docs/BLOCKS.md).
# FL0W_ALLOW_SHELL=1
# Публичный https-адрес сервера (нужен для вебхуков Telegram), без пути
# FL0W_PUBLIC_URL=https://fl0w.example.com
# Свой сервер Telegram Bot API
# FL0W_TELEGRAM_API=https://api.telegram.org
# Секреты: в параметрах блоков ссылаются как env:FL0W_SECRET_ИМЯ
# FL0W_SECRET_TELEGRAM_BOT_TOKEN=
